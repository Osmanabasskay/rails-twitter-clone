<div class="container">
  <div class="post">
    <div class="post-content"><%= @post.content %></div>
    <div class="post-meta">
      <span>Posted <%= time_ago_in_words(@post.created_at) %> ago</span>
      <% if @post.updated_at != @post.created_at %>
        <span>• Updated <%= time_ago_in_words(@post.updated_at) %> ago</span>
      <% end %>
    </div>
    <div class="post-actions">
      <%= link_to "Edit", edit_post_path(@post), class: "btn" %>
      <%= link_to "Delete", @post, method: :delete, 
                  data: { confirm: "Are you sure you want to delete this tweet?" }, 
                  class: "btn btn-danger" %>
      <%= link_to "Back to All Tweets", posts_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>
