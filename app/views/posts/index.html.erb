<div class="container">
  <h1>All Tweets</h1>
  
  <% if @posts.any? %>
    <% @posts.each do |post| %>
      <div class="post">
        <div class="post-content"><%= post.content %></div>
        <div class="post-meta">
          <span>Posted <%= time_ago_in_words(post.created_at) %> ago</span>
        </div>
        <div class="post-actions">
          <%= link_to "View", post, class: "btn btn-secondary" %>
          <%= link_to "Edit", edit_post_path(post), class: "btn" %>
          <%= link_to "Delete", post, method: :delete, 
                      data: { confirm: "Are you sure you want to delete this tweet?" }, 
                      class: "btn btn-danger" %>
        </div>
      </div>
    <% end %>
  <% else %>
    <p>No tweets yet. <%= link_to "Create the first tweet!", new_post_path %></p>
  <% end %>
</div>
